---
// Warning Alert banner displayed above the navbar across all pages
---

<div
  role="alert"
  class="w-full bg-amber-500/15 dark:bg-amber-950/50 backdrop-blur-md border-b border-amber-500/30 dark:border-amber-500/30 text-amber-950 dark:text-amber-200 px-4 py-2.5 text-xs sm:text-sm font-medium transition-colors"
>
  <div class="max-w-7xl mx-auto flex items-center justify-center gap-2 text-center flex-wrap">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-4 h-4 shrink-0 text-amber-600 dark:text-amber-400"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
      <line x1="12" y1="9" x2="12" y2="13" />
      <line x1="12" y1="17" x2="12.01" y2="17" />
    </svg>
    <span>
      This is the old version. Please look at the new version:
      <a
        href="https://www.lakshyaraj.dev/"
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold underline underline-offset-4 decoration-amber-600/60 dark:decoration-amber-400/60 hover:decoration-amber-700 dark:hover:decoration-amber-300 hover:text-amber-800 dark:hover:text-amber-100 transition-colors inline-flex items-center gap-1 ml-1"
      >
        https://www.lakshyaraj.dev/
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-3.5 h-3.5 inline shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
          <polyline points="15 3 21 3 21 9" />
          <line x1="10" y1="14" x2="21" y2="3" />
        </svg>
      </a>
    </span>
  </div>
</div>
